{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Adf-project-1-avdoyizode"
		},
		"Destination_Sales_Data_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Destination_Sales_Data'"
		},
		"Sales_source_data_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Sales_source_data'"
		},
		"Destination_Sales_Data_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SALES"
		},
		"Destination_Sales_Data_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"Destination_Sales_Data_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "VRFNVBY-SG32738.snowflakecomputing.com"
		},
		"Sales_source_data_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfprojectavd.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pipeline1')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Filtering Records",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "Sales_data_from_ADLS_To_Snowflake",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"SalesDataADLS": {},
									"Snowflake": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/Sales_data_from_ADLS_To_Snowflake')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Sales_Data')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Sales_source_data",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "sales_data.csv",
						"fileSystem": "sales-data"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "ORDERNUMBER",
						"type": "String"
					},
					{
						"name": "QUANTITYORDERED",
						"type": "String"
					},
					{
						"name": "PRICEEACH",
						"type": "String"
					},
					{
						"name": "ORDERLINENUMBER",
						"type": "String"
					},
					{
						"name": "SALES",
						"type": "String"
					},
					{
						"name": "ORDERDATE",
						"type": "String"
					},
					{
						"name": "STATUS",
						"type": "String"
					},
					{
						"name": "QTR_ID",
						"type": "String"
					},
					{
						"name": "MONTH_ID",
						"type": "String"
					},
					{
						"name": "YEAR_ID",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Sales_source_data')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Sales_Data_Destination')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Destination_Sales_Data",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "SnowflakeV2Table",
				"schema": [
					{
						"name": "ORDERNUMBER",
						"type": "NUMBER",
						"precision": 38,
						"scale": 0
					},
					{
						"name": "QUANTITYORDERED",
						"type": "NUMBER",
						"precision": 38,
						"scale": 0
					},
					{
						"name": "PRICEEACH",
						"type": "FLOAT"
					},
					{
						"name": "ORDERLINENUMBER",
						"type": "NUMBER",
						"precision": 38,
						"scale": 0
					},
					{
						"name": "SALES",
						"type": "FLOAT"
					},
					{
						"name": "ORDERDATE",
						"type": "DATE"
					},
					{
						"name": "STATUS",
						"type": "VARCHAR"
					},
					{
						"name": "QTR_ID",
						"type": "NUMBER",
						"precision": 38,
						"scale": 0
					},
					{
						"name": "MONTH_ID",
						"type": "NUMBER",
						"precision": 38,
						"scale": 0
					},
					{
						"name": "YEAR_ID",
						"type": "NUMBER",
						"precision": 38,
						"scale": 0
					}
				],
				"typeProperties": {
					"schema": "PUBLIC",
					"table": "SALES"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Destination_Sales_Data')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Destination_Sales_Data')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SnowflakeV2",
				"typeProperties": {
					"authenticationType": "Basic",
					"accountIdentifier": "SG32738",
					"user": "AVDOYIZODE",
					"database": "[parameters('Destination_Sales_Data_properties_typeProperties_database')]",
					"warehouse": "SALES_WH",
					"role": "[parameters('Destination_Sales_Data_properties_typeProperties_role')]",
					"host": "[parameters('Destination_Sales_Data_properties_typeProperties_host')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('Destination_Sales_Data_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Sales_source_data')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('Sales_source_data_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('Sales_source_data_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Sales_data_from_ADLS_To_Snowflake')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Sales_Data",
								"type": "DatasetReference"
							},
							"name": "SalesDataADLS"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "Sales_Data_Destination",
								"type": "DatasetReference"
							},
							"name": "Snowflake"
						}
					],
					"transformations": [
						{
							"name": "AmountBasedFilter"
						}
					],
					"scriptLines": [
						"source(output(",
						"          ORDERNUMBER as string,",
						"          QUANTITYORDERED as string,",
						"          PRICEEACH as string,",
						"          ORDERLINENUMBER as string,",
						"          SALES as string,",
						"          ORDERDATE as string,",
						"          STATUS as string,",
						"          QTR_ID as string,",
						"          MONTH_ID as string,",
						"          YEAR_ID as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> SalesDataADLS",
						"SalesDataADLS filter(SALES>='2000') ~> AmountBasedFilter",
						"AmountBasedFilter sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          ORDERNUMBER as decimal(38,0),",
						"          QUANTITYORDERED as decimal(38,0),",
						"          PRICEEACH as double,",
						"          ORDERLINENUMBER as decimal(38,0),",
						"          SALES as double,",
						"          ORDERDATE as date,",
						"          STATUS as string,",
						"          QTR_ID as decimal(38,0),",
						"          MONTH_ID as decimal(38,0),",
						"          YEAR_ID as decimal(38,0)",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     stageInsert: true) ~> Snowflake"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Sales_Data')]",
				"[concat(variables('factoryId'), '/datasets/Sales_Data_Destination')]"
			]
		}
	]
}